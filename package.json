{
  "name": "codegraph-kit",
  "version": "0.2.4",
  "description": "Standalone code knowledge-graph MCP server for TypeScript/JavaScript repos: a built-in indexer, a symbol-aware edit loop as first-class agent tools, and KG-only coding agents for Claude Code, OpenCode, Cursor, Codex CLI and Code Puppy.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codegraph",
    "knowledge-graph",
    "code-navigation",
    "ai-agent",
    "llm",
    "sqlite",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shekharnair96/codegraph-kit.git"
  },
  "homepage": "https://github.com/shekharnair96/codegraph-kit#readme",
  "bugs": {
    "url": "https://github.com/shekharnair96/codegraph-kit/issues"
  },
  "type": "commonjs",
  "bin": {
    "codegraph-mcp": "codegraph-ext/codegraph-mcp.cjs",
    "codegraph": "codegraph-ext/engine/bin/codegraph.js"
  },
  "files": [
    "codegraph-ext/",
    "agents/",
    "install/",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "ts-morph": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "test": "node --test test/fixture.test.cjs test/runner.test.cjs test/detect-runner.test.cjs test/budget.test.cjs test/hosts.test.cjs test/verify-cache.test.cjs",
    "cg:index": "node codegraph-ext/engine/bin/codegraph.js index",
    "cg:mcp": "node codegraph-ext/codegraph-mcp.cjs",
    "cg:refresh": "node codegraph-ext/build-body-index.cjs && node codegraph-ext/augment.cjs",
    "cg:locate": "node codegraph-ext/query.cjs locate",
    "cg:plan": "node codegraph-ext/query.cjs plan",
    "cg:impact": "node codegraph-ext/query.cjs impact",
    "cg:read": "node codegraph-ext/read-context.cjs",
    "cg:apply": "node codegraph-ext/apply-edits.cjs",
    "cg:apply-at-site": "node codegraph-ext/apply-at-site.cjs",
    "cg:verify": "node codegraph-ext/verify-affected.cjs",
    "cg:test-one": "node codegraph-ext/test-one.cjs",
    "cg:graph": "node codegraph-ext/cg-graph.cjs",
    "cg:bench": "node codegraph-ext/token-bench.cjs"
  },
  "engines": {
    "node": ">=18"
  }
}
